        <mxCell id="-SKJp9Za45CinuXW4yb6-251" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;rounded=0;" value="&lt;div class=&quot;math-block&quot; data-math=&quot;N_{\text{max}} = + (1.111\dots1)_2 \times 2^{254 - 127} = (2 - 2^{-23}) \times 2^{127} \approx \mathbf{3.4028235 \times 10^{38}}&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;$$+ 1.11\dots10_2 \times 2^{ 127}$$&lt;/div&gt;" vertex="1">
