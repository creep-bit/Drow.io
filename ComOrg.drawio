        <mxCell id="-SKJp9Za45CinuXW4yb6-252" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;rounded=0;" value="&lt;div class=&quot;math-block&quot; data-math=&quot;N_{\text{min}} = + (1.0)_2 \times 2^{1 - 127} = 2^{-126} \approx \mathbf{1.1754944 \times 10^{-38}}&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;$$+ 1.00\dots01_2 \times 2^{ -126} $$&lt;/div&gt;" vertex="1">
