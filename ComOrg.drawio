        <mxCell id="_hrWZGNeymvtdVtOxGqp-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;rounded=0;" value="向偶数舍入" vertex="1">
          <mxGeometry height="40" width="80" x="1440" y="720" as="geometry" />
        </mxCell>
        <mxCell id="_hrWZGNeymvtdVtOxGqp-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;rounded=0;" value="四舍五入" vertex="1">
          <mxGeometry height="40" width="80" x="1440" y="800" as="geometry" />
        </mxCell>
        <mxCell id="_hrWZGNeymvtdVtOxGqp-6" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" value="IEEE 754 标准默认规定，缺省的舍入技术应该向最近的值舍入。如果一个数与两个最近的可表示的值的距离相等，则选择最低位为 0 的作为舍入值" vertex="1">
          <mxGeometry height="40" width="440" x="1520" y="720" as="geometry" />
        </mxCell>
        <mxCell id="_hrWZGNeymvtdVtOxGqp-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;rounded=0;" value="舍入到最近的值；若处于正中间（平局），则可以选择向远离 0 的方向进位或者向无穷进位" vertex="1">
          <mxGeometry height="40" width="370" x="1520" y="800" as="geometry" />
        </mxCell>
        <mxCell id="_hrWZGNeymvtdVtOxGqp-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#9673a6;fillColor=#e1d5e7;align=center;verticalAlign=middle;rounded=0;" value="向零舍入" vertex="1">
          <mxGeometry height="40" width="80" x="1280" y="880" as="geometry" />
        </mxCell>
        <mxCell id="_hrWZGNeymvtdVtOxGqp-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#9673a6;fillColor=#e1d5e7;align=center;verticalAlign=middle;rounded=0;" value="直接扔掉多余的低位，结果朝数轴上 0 的方向靠拢。" vertex="1">
          <mxGeometry height="40" width="310" x="1360" y="880" as="geometry" />
        </mxCell>
        <mxCell id="_hrWZGNeymvtdVtOxGqp-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;rounded=0;" value="&lt;span class=&quot;math-inline&quot; data-math=&quot;+\infty&quot; data-index-in-node=&quot;2&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;向正无穷舍入&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="80" x="1280" y="960" as="geometry" />
        </mxCell>
        <mxCell id="_hrWZGNeymvtdVtOxGqp-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;rounded=0;" value="&lt;span class=&quot;math-inline&quot; data-math=&quot;+\infty&quot; data-index-in-node=&quot;2&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;向负无穷舍入&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="80" x="1280" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="_hrWZGNeymvtdVtOxGqp-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;rounded=0;" value="取不小于真实值的最小可表示数" vertex="1">
